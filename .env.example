# One app. Leave VITE_CMS_URL empty so the storefront calls /api on the same host.
# Set it only if the API lives on a different origin.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API Keys → anon / public key
VITE_SUPABASE_ANON_KEY=

# Public storefront URL for auth email links (production). Leave empty to use the current browser origin in dev.
# Example: https://kamaru.com.ph
VITE_SITE_URL=

# Server-only (never expose in the browser). Supabase → Project Settings → API Keys → service_role
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Google Analytics 4 id, like G-XXXXXXXX
VITE_GA4_MEASUREMENT_ID=
